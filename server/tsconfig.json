{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // --- These two lines are REQUIRED for @colyseus/schema's @type decorators ---
    // experimentalDecorators turns on the @type(...) syntax, and turning OFF
    // useDefineForClassFields lets a field initializer (e.g. `x = 0`) coexist
    // with the decorator instead of overwriting it.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "include": ["src"]
}
